# Copy to server/.env and fill in.  DO NOT COMMIT YOUR REAL .ENV

# HS256 signing secret for JWT access token.  This is a real CREDENTIAL
# - Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# - NEVER COMMIT THE REAL SECRET!

JWT_SECRET=

# How long access token stays valid. Keep it short.
ACCESS_TOKEN_TTL=15m

# bcrypt cost factor (10 -12 range)
BCRYPT_ROUNDS=12

DATABASE_URL=
PORT=
CORS_ORIGIN=